# ==============================================================================
# DRIXIO ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust the parameters for your project.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY DATABASE CONNECTION STRING (DATABASE_URL)
# Choose one of the connection string formats below:
# ------------------------------------------------------------------------------

# SQLite (Local Embedded File)
DATABASE_URL="file:./drixio.sqlite"

# PostgreSQL (Local, Docker, Supabase, Neon, or RDS)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/mydb"
# DATABASE_URL="postgresql://postgres.xxx:secret@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require"

# MySQL / MariaDB (Local, Docker, or Cloud)
# DATABASE_URL="mysql://root:password@localhost:3306/mydb"

# Microsoft SQL Server (MSSQL, Local, Docker, or Azure SQL)
# DATABASE_URL="mssql://sa:Password123!@localhost:1433/master"
# DATABASE_URL="mssql://user:secret@server.database.windows.net:1433/mydb?encrypt=true"

# MongoDB (NoSQL, Local, Docker, or MongoDB Atlas SRV)
# DATABASE_URL="mongodb://localhost:27017/drixio_dev"
# DATABASE_URL="mongodb+srv://user:secret@cluster0.mongodb.net/mydb?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 2. DRIXIO STUDIO SERVER SETTINGS (Optional)
# ------------------------------------------------------------------------------
# PORT=51213
# HOST=localhost
# READ_ONLY=false

# ------------------------------------------------------------------------------
# 3. BYOK AI ASSISTANT CONFIGURATION (Optional, or configure via Studio UI)
# ------------------------------------------------------------------------------
# DRIXIO_AI_PROVIDER="deepseek"
# DRIXIO_AI_API_KEY="sk-..."
# DRIXIO_AI_BASE_URL="https://api.deepseek.com"
# DRIXIO_AI_MODEL="deepseek-chat"

