{
   "name": "drixio",
   "version": "1.2.1",
   "description": "A lightweight interactive TUI database client",
   "bin": {
      "drixio": "dist/cli.js"
   },
   "files": [
      "dist/cli.js",
      "dist/studio"
   ],
   "scripts": {
      "dev": "tsx bin/cli.ts",
      "dev:studio": "vite --config studio/vite.config.ts",
      "dev:all": "node scripts/dev-all.js",
      "build:cli": "tsup",
      "build:studio": "vite build --config studio/vite.config.ts",
      "build": "pnpm build:cli && pnpm build:studio",
      "test": "node scripts/test-runner.js",
      "typecheck": "tsc --noEmit",
      "lint": "biome lint .",
      "format": "biome format --write .",
      "check": "biome check --write .",
      "db:up": "docker compose up -d",
      "db:down": "docker compose down",
      "db:status": "docker compose ps",
      "db:logs": "docker compose logs -f",
      "build:sea": "node scripts/build-sea.js",
      "prepublishOnly": "pnpm build"
   },
   "keywords": [
      "database",
      "tui",
      "cli",
      "drixio",
      "postgres",
      "sqlite",
      "mysql",
      "terminal",
      "editor",
      "developer",
      "sql",
      "data",
      "db",
      "ui"
   ],
   "author": "TerKSDev",
   "license": "MIT",
   "engines": {
      "node": ">=22.0.0"
   },
   "type": "module",
   "publishConfig": {
      "access": "public"
   },
   "devDependencies": {
      "@biomejs/biome": "^2.5.14",
      "@types/mssql": "^12.3.0",
      "@types/node": "^26.1.2",
      "@types/pg": "^8.20.0",
      "@types/ssh2": "^1.15.6",
      "tsup": "^8.5.1",
      "tsx": "^4.23.1",
      "typescript": "^7.0.2",
      "vite": "^8.1.5",
      "vitest": "^4.1.10",
      "sql-formatter": "^15.8.2"
   },
   "dependencies": {
      "@hono/node-server": "^2.0.12",
      "@inquirer/prompts": "^8.5.2",
      "hono": "^4.12.32",
      "mongodb": "^7.6.0",
      "mssql": "^12.7.2",
      "mysql2": "^3.23.2",
      "open": "^11.0.0",
      "pg": "^8.22.0",
      "picocolors": "^1.1.1",
      "ssh2": "^1.17.0"
   }
}
